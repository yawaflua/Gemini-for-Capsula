# /etc/conf.d/marusya-agent — settings for the marusya-agent OpenRC service.
# The agent binary is downloaded from MARUSYA_SERVER into MARUSYA_AGENT_DIR
# (tmpfs) on every start; run marusya-server with -agent_dir.

# Set by `make deploy-agent SERVER=...`, e.g. ws://192.168.31.10:8080/v1/stream
MARUSYA_SERVER=ws://192.168.31.102:8080/v1/stream
# The server's shared token, or the speaker's own token from the web panel
# (Колонки → Профиль колонки → Новый токен).
MARUSYA_AUTH_TOKEN=secret
MARUSYA_LANGUAGE=ru-RU
# Where the speaker is, for "сколько время" and "какая погода". Empty values
# fall back to marusya-server -default_location / -default_timezone. A
# profile in the web panel overrides these.
MARUSYA_LOCATION=
MARUSYA_TIMEZONE=
MARUSYA_CAPTURE_DEVICE=default
MARUSYA_PLAYBACK_DEVICE=default
MARUSYA_MIXER_CONTROL=Master
# Run this command with the assistant state on every change, e.g. to
# drive an LED ring owned by another process (see indicator/statecmd).
MARUSYA_STATE_COMMAND=
# External volume program, called as `<cmd> get`, `<cmd> set <0..100>`
# and `<cmd> mute on|off`. Takes precedence over MARUSYA_MIXER_CONTROL.
# See configs/volume-capsule-ipc.example.sh.
MARUSYA_VOLUME_CMD=

# Keyword spotter: reads 16 kHz mono S16LE on stdin, prints a line per hit.
MARUSYA_WAKE_COMMAND=
# Hardware button: evdev node (see `cat /proc/bus/input/devices`).
MARUSYA_BUTTON_DEVICE=

# Bluetooth pairing: "auto" = bt-pair if present, "" = built-in bluetoothctl flow.
MARUSYA_BT_PAIR_COMMAND=auto

MARUSYA_MPV_SOCKET=/tmp/mpv.sock

# Publish the LED ring, display and sensors on the system D-Bus as
# ru.marusya.Agent (needs /etc/dbus-1/system.d/ru.marusya.Agent.conf).
MARUSYA_DBUS=true

# Plugins that run on the speaker: one directory per plugin with a
# plugin.json (see sdk/README.md). Empty disables them.
MARUSYA_PLUGINS_DIR=

MARUSYA_AGENT_DIR=/tmp/marusya
MARUSYA_AGENT_ARCH=arm64
# On every connection compare the agent with the server's and, if it
# differs, download the new one and restart when idle. false keeps the
# binary that was downloaded at boot (e.g. for testing a build by hand).
MARUSYA_AUTO_UPDATE=true

# Extra command-line flags, e.g. "-log_level debug -follow_up=false".
MARUSYA_AGENT_ARGS=""
