# Copy to configs/server.env and fill in. Used by deploy/server/docker-compose.yaml
# and by `set -a; . configs/server.env; set +a` for a bare binary.

GEMINI_API_KEY=
# Token speakers present (MARUSYA_AUTH_TOKEN in /etc/conf.d/marusya-agent).
MARUSYA_AUTH_TOKEN=change-me
# Web panel at http://<server>:8080/panel/. Empty disables it.
MARUSYA_PANEL_PASSWORD=
# Wake word spotted on the server (docker compose --profile wake up -d).
# Words are comma separated and changeable in the panel; Hebrew works too.
# MARUSYA_WAKE_URL=ws://marusya-wake:2700
# MARUSYA_WAKE_WORDS=антон, אנטון
# Keeps settings changed in the panel across restarts (docker-compose mounts
# a volume at /data).
# MARUSYA_SETTINGS_FILE=/data/settings.json
MARUSYA_LANGUAGE=ru-RU
# Other languages users speak (speech recognition hints), e.g. he-IL; also in the web panel.
# MARUSYA_EXTRA_LANGUAGES=he-IL
GEMINI_VOICE=Kore

# Where speakers are unless they report it themselves (time and weather).
MARUSYA_DEFAULT_LOCATION=Ашдод
MARUSYA_DEFAULT_TIMEZONE=Asia/Jerusalem

# End of speech: server (Gemini, robust) or device.
# MARUSYA_VAD=server
# MARUSYA_IDLE_TIMEOUT=2m
# MARUSYA_LOG_LEVEL=debug
# GEMINI_MODEL=gemini-2.5-flash-native-audio-latest

# Claude instead of Gemini Live (speech still goes through Gemini, so keep
# GEMINI_API_KEY as well).
# MARUSYA_PROVIDER=claude
# ANTHROPIC_API_KEY=
# MARUSYA_CLAUDE_MODEL=claude-haiku-5-5
# MARUSYA_CLAUDE_EFFORT=low

# Home Assistant: voice control of the smart home (home_find, home_control).
# Token: Home Assistant → profile → Security → Long-lived access tokens.
# MARUSYA_HA_URL=http://homeassistant.local:8123
# MARUSYA_HA_TOKEN=
# Domains controllable by voice (default: light, switch, fan, cover, climate,
# media_player, scene, script, input_boolean, vacuum, humidifier, button).
# MARUSYA_HA_DOMAINS=

# YouTube and radio for speakers ("включи Кино — Группа крови"). Needs yt-dlp
# and ffmpeg on the server (included in the Docker image).
# MARUSYA_MEDIA=true
# MARUSYA_YTDLP_ARGS=--js-runtimes node
# Per-speaker region, languages and tokens (web panel → Колонки → Профиль).
# MARUSYA_PROFILES_FILE=/data/devices.json
